# Required by the Express analytics backend
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/<database>?retryWrites=true&w=majority
MONGODB_DB=portfolio_analytics

# Generate independent random secrets of at least 32 characters.
ANALYTICS_ADMIN_TOKEN=replace-with-a-long-random-secret-at-least-32-characters
VISITOR_HASH_SECRET=replace-with-a-different-long-random-secret-at-least-32-characters

# Render sets PORT and NODE_ENV automatically.
NODE_ENV=production
